# Copy to keystore.properties in the project root and fill in values.
# Do not commit keystore.properties or your .jks file.
#
# Generate a keystore (example):
#   keytool -genkeypair -v -keystore release/optireader-upload.jks -alias optireader \
#     -keyalg RSA -keysize 2048 -validity 10000 -storepass YOUR_PASS -keypass YOUR_PASS \
#     -dname "CN=Your Name, OU=..., O=..., L=..., ST=..., C=..."
#
storeFile=release/optireader-upload.jks
storePassword=
keyAlias=optireader
keyPassword=
