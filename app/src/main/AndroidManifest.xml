<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Full device storage scan (Android 11+). User grants in system Settings. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/optireader_network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Optireader"
        android:usesCleartextTraffic="true"
        tools:replace="android:networkSecurityConfig,android:allowBackup">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Optireader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".epub.HighlightProcessTextActivity"
            android:exported="true"
            android:label="@string/menu_item_highlight"
            android:theme="@style/Theme.Optireader">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data
                android:name="android.support.PROCESS_TEXT_READONLY"
                android:value="true" />
        </activity>

        <activity
            android:name=".epub.GoogleProcessTextActivity"
            android:exported="true"
            android:label="@string/menu_item_google"
            android:theme="@style/Theme.Optireader">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data
                android:name="android.support.PROCESS_TEXT_READONLY"
                android:value="true" />
        </activity>

        <activity
            android:name=".epub.FindProcessTextActivity"
            android:exported="true"
            android:label="@string/menu_item_find"
            android:theme="@style/Theme.Optireader">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data
                android:name="android.support.PROCESS_TEXT_READONLY"
                android:value="true" />
        </activity>

        <activity
            android:name=".epub.ReadAloudProcessTextActivity"
            android:exported="true"
            android:label="@string/menu_item_read_aloud"
            android:theme="@style/Theme.Optireader">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data
                android:name="android.support.PROCESS_TEXT_READONLY"
                android:value="true" />
        </activity>

        <activity
            android:name=".epub.DictionaryProcessTextActivity"
            android:exported="true"
            android:label="@string/menu_item_dictionary"
            android:theme="@style/Theme.Optireader">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data
                android:name="android.support.PROCESS_TEXT_READONLY"
                android:value="true" />
        </activity>

    </application>

</manifest>